# Copier ce fichier en .env et l'adapter. Ne jamais publier le fichier .env.

# Passerelle RS-485 / Ethernet (Waveshare en mode TCP server transparent, 9600 8N2)
WAVESHARE_HOST=192.0.2.10
WAVESHARE_PORT=502

# Broker MQTT (Home Assistant ou autre)
MQTT_HOST=192.0.2.20
MQTT_PORT=1883
MQTT_PREFIX=baillzoning
MQTT_USER=
MQTT_PASSWORD=

# 0 = ne jamais répondre à l'UC (lecture seule), 1 = émulation de la passerelle 10
EMU_RESPOND=1

# Bornes des consignes par mode (°C)
HOT_MIN=16
HOT_MAX=30
COLD_MIN=16
COLD_MAX=30

# Thermostats : nombre, noms (numéro:nom séparés par des virgules), et ceux autorisés aux commandes
THERMOSTAT_COUNT=5
THERMOSTAT_NAMES=1:Salon,2:Chambre,3:Bureau,4:Parents,5:Cuisine
VERIFIED_THERMOSTATS=

# Profil de carte du bus (nom dans profiles/, ou chemin vers un .json)
PROFILE=baillzoning-uc82

# Libellés des codes d'erreur Intesis (fichier JSON local, non fourni dans le dépôt). Vide : numéro seul.
INTESIS_ERRORS_FILE=
